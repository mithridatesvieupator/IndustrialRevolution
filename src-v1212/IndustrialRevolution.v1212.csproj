<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Industrial Revolution build for Bannerlord 1.2.12 (e.g. for Shokuho and other total conversions that stay on 1.2.12).
    Compiles the same sources as src/IndustrialRevolution.csproj, but against BUTR's 1.2.12 reference assemblies,
    so 1.2.12 does not need to be installed. API differences are handled with #if GAME_V1212 in the shared sources.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>IndustrialRevolution</AssemblyName>
    <RootNamespace>IndustrialRevolution</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);GAME_V1212</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <GameFolder Condition="'$(GameFolder)' == ''">D:\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <BannerlordRefVersion>1.2.12.77991</BannerlordRefVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\**\*.cs" Exclude="..\src\obj\**;..\src\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Game 1.2.12 API surface (reference-only, nothing is copied to output) -->
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="$(BannerlordRefVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Harmony and MCM v5 have the same public API across game versions; players get them from their own installs -->
    <Reference Include="0Harmony" HintPath="$(GameFolder)\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll" Private="false" />
    <Reference Include="MCMv5" HintPath="$(GameFolder)\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll" Private="false" />
    <Reference Include="MCM.UI.Adapter.MCMv5" HintPath="$(GameFolder)\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCM.UI.Adapter.MCMv5.dll" Private="false" />
  </ItemGroup>
</Project>
